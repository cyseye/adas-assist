# adas-assist .gitignore（运行时数据不入库）

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 运行时数据（本地生成，不入库）
.build/
.state/
*.log
*.tmp

# 决策/台账运行时数据：目录壳入库（README 格式约定），内容不入
decisions/adr/**
!decisions/adr/.gitkeep
decisions/postmortems/**
!decisions/postmortems/README.md
!decisions/KNOWLEDGE.md

# 用户画像运行时数据
memory/**
!memory/USER-PREFERENCES.md
!memory/MEMORY.md

# 本机配置（永不入库）
settings.json
settings.local.json
skills/*/registry/

# v1.0 单任务本地运行状态
.adas-assist/

# Codex 发现入口只跟踪指向根技能的软链接，不保存安装副本
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/_shared
!.agents/skills/scripts
!.agents/skills/decision-consensus
!.agents/skills/decision-explore
!.agents/skills/decision-improve
!.agents/skills/decision-lifecycle
!.agents/skills/decision-record
!.agents/skills/decision-verify
!.agents/skills/devils-panel
!.agents/skills/effect-governance
!.agents/skills/finish-check
!.agents/skills/info-collection
!.agents/skills/io-governance
!.agents/skills/memory-governance
!.agents/skills/os
!.agents/skills/skill-evolution

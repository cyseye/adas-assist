{
  "$comment": "adas-assist 反射层 hooks 接线模板——新机接入用：把本文件的 hooks 键合并进 ~/.claude/settings.json（jq -s '.[0] * .[1]' ~/.claude/settings.json bootstrap/settings.hooks.json，在仓根执行；合并前先备份原文件）。command 用 $HOME 展开跨用户名。env/apiKeyHelper/statusline 等本机配置不在本模板，按新机实际情况自配。",
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/cc-commit-gate.py"},
        {"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/t38-settings-guard.py"}
      ]}
    ],
    "PostToolUse": [
      {"matcher": "Skill|Agent", "hooks": [{"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/collect.py"}]}
    ],
    "Stop": [
      {"hooks": [
        {"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/cleanup-builds.py"},
        {"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/session-review.py"},
        {"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/reflex-check.py"}
      ]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/session-start.py"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 $HOME/.claude/skills/skill-evolution/scripts/knowledge-recall.py"}]}
    ]
  }
}
